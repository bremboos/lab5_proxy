  "item": [
    {
      "name": "1. GET 200 (Cache MISS)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', () => pm.response.to.have.status(200));",
              "pm.test('Content-Type is image/jpeg', () => pm.response.to.have.header('Content-Type', 'image/jpeg'));",
              "pm.test('X-Cache is MISS', () => pm.response.to.have.header('X-Cache', 'MISS'));"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/200",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "200"
          ]
        }
      },
      "response": []
    },
